# Copy to .env.local. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Settled by open-questions #9. Example: https://your-project.vercel.app
NEXT_PUBLIC_SITE_URL=
# Server-only — no NEXT_PUBLIC_ prefix, never sent to the browser.
# Supabase dashboard -> Project Settings -> API Keys -> Secret keys -> default.
# Starts with sb_secret_. Used by app/api/partners to create partner accounts.
SUPABASE_SECRET_KEY=
